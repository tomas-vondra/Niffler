# Niffler local stack configuration - copy to `.env` and edit.
#
#     cp .env.example .env
#
# `.env` is git-ignored and is read automatically by `docker compose`.
# NEVER commit real credentials - this file contains placeholders only.
#
# Everything here has a working default, so a fresh clone runs with
# `docker compose up -d` and no .env at all.

# ------------------------------------------------------------------------------
# Network exposure
# ------------------------------------------------------------------------------
# Host interface the published ports bind to. 127.0.0.1 keeps Elasticsearch,
# Kibana and Grafana reachable from this machine only.
#
# Setting this to 0.0.0.0 publishes an UNAUTHENTICATED Elasticsearch (and a
# Grafana whose password may still be "admin") on every interface of the host.
# Do not do that until you have enabled X-Pack security and set real credentials -
# see the header of docker-compose.yml.
NIFFLER_BIND_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# Grafana admin account
# ------------------------------------------------------------------------------
# Defaults are admin/admin. Change them before anyone but you can reach port 3000.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# ------------------------------------------------------------------------------
# Container runtime user (Linux hosts only)
# ------------------------------------------------------------------------------
# The image runs as UID/GID 1000. If your host user differs, the bind-mounted
# ./data and ./results directories will not be writable - set these to the output
# of `id -u` / `id -g` and uncomment the `user:` line in docker-compose.yml.
# UID=1000
# GID=1000
