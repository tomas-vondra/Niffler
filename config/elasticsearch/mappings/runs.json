{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic_templates": [
      {
        "provenance_package_versions_as_keyword": {
          "path_match": "provenance.environment.packages.*",
          "match_mapping_type": "string",
          "mapping": {"type": "keyword"}
        }
      },
      {
        "unmapped_integers_as_double": {
          "match_mapping_type": "long",
          "mapping": {"type": "double"}
        }
      },
      {
        "unmapped_strings_as_keyword": {
          "match_mapping_type": "string",
          "mapping": {"type": "keyword"}
        }
      }
    ],
    "properties": {
      "run_id": {"type": "keyword"},
      "kind": {"type": "keyword"},
      "experiment": {"type": "keyword"},
      "parent_run_id": {"type": "keyword"},
      "profile": {"type": "keyword"},
      "strategy_key": {"type": "keyword"},
      "strategy_name": {"type": "keyword"},
      "strategy_params": {"type": "flattened"},
      "symbol": {"type": "keyword"},
      "start_date": {"type": "date"},
      "end_date": {"type": "date"},
      "initial_capital": {"type": "double"},
      "final_capital": {"type": "double"},
      "total_return": {"type": "double"},
      "total_return_pct": {"type": "double"},
      "max_drawdown": {"type": "double"},
      "sharpe_ratio": {"type": "double"},
      "win_rate": {"type": "double"},
      "total_trades": {"type": "integer"},
      "profit_factor": {"type": "double"},
      "average_win": {"type": "double"},
      "average_loss": {"type": "double"},
      "largest_win": {"type": "double"},
      "largest_loss": {"type": "double"},
      "num_winning_trades": {"type": "integer"},
      "num_losing_trades": {"type": "integer"},
      "commission": {"type": "double"},
      "cost_model": {"type": "keyword"},
      "risk_manager": {
        "properties": {
          "name": {"type": "keyword"},
          "class": {"type": "keyword"},
          "parameters": {"type": "flattened"}
        }
      },
      "git_sha": {"type": "keyword"},
      "git_dirty": {"type": "boolean"},
      "data_sha256": {"type": "keyword"},
      "best_parameters": {"type": "flattened"},
      "analysis_parameters": {"type": "flattened"},
      "stages": {"type": "flattened"},
      "holdout_data_sha256": {"type": "keyword"},
      "holdout_excess_pct": {"type": "double"},
      "results_truncated": {"type": "boolean"},
      "total_commission": {"type": "double"},
      "total_slippage": {"type": "double"},
      "benchmark_name": {"type": "keyword"},
      "benchmark_return_pct": {"type": "double"},
      "benchmark_sharpe_ratio": {"type": "double"},
      "benchmark_max_drawdown": {"type": "double"},
      "benchmark_total_cost": {"type": "double"},
      "benchmark_error": {"type": "text"},
      "excess_return_pct": {"type": "double"},
      "information_ratio": {"type": "double"},
      "round_trip_count": {"type": "integer"},
      "mean_trade_return_pct": {"type": "double"},
      "t_statistic": {"type": "double"},
      "p_value": {"type": "double"},
      "sharpe_ci_low": {"type": "double"},
      "sharpe_ci_high": {"type": "double"},
      "sharpe_ci_confidence": {"type": "double"},
      "significance_min_trades": {"type": "integer"},
      "is_sample_sufficient": {"type": "boolean"},
      "is_significant": {"type": "boolean"},
      "significance_verdict": {"type": "text"},
      "created_at": {"type": "date"},
      "provenance": {
        "properties": {
          "run_timestamp_utc": {"type": "date"},
          "code": {
            "properties": {
              "git_sha": {"type": "keyword"},
              "git_sha_short": {"type": "keyword"},
              "branch": {"type": "keyword"},
              "dirty": {"type": "boolean"},
              "niffler_version": {"type": "keyword"}
            }
          },
          "data": {
            "properties": {
              "path": {"type": "keyword"},
              "sha256": {"type": "keyword"},
              "size_bytes": {"type": "long"},
              "modified_utc": {"type": "date"}
            }
          },
          "environment": {
            "properties": {
              "python_version": {"type": "keyword"},
              "platform": {"type": "keyword"},
              "packages": {
                "properties": {
                  "niffler": {"type": "keyword"},
                  "pandas": {"type": "keyword"},
                  "numpy": {"type": "keyword"},
                  "ccxt": {"type": "keyword"},
                  "yfinance": {"type": "keyword"},
                  "elasticsearch": {"type": "keyword"},
                  "python-dateutil": {"type": "keyword"}
                }
              }
            }
          }
        }
      }
    }
  }
}
