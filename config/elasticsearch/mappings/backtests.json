{
  "mappings": {
    "dynamic_templates": [
      {
        "provenance_package_versions_as_keyword": {
          "path_match": "provenance.environment.packages.*",
          "match_mapping_type": "string",
          "mapping": {"type": "keyword"}
        }
      }
    ],
    "properties": {
      "backtest_id": {"type": "keyword"},
      "strategy_name": {"type": "keyword"},
      "strategy_params": {"type": "object"},
      "symbol": {"type": "keyword"},
      "start_date": {"type": "date"},
      "end_date": {"type": "date"},
      "initial_capital": {"type": "double"},
      "final_capital": {"type": "double"},
      "total_return": {"type": "double"},
      "total_return_pct": {"type": "double"},
      "max_drawdown": {"type": "double"},
      "sharpe_ratio": {"type": "double"},
      "win_rate": {"type": "double"},
      "total_trades": {"type": "integer"},
      "profit_factor": {"type": "double"},
      "average_win": {"type": "double"},
      "average_loss": {"type": "double"},
      "largest_win": {"type": "double"},
      "largest_loss": {"type": "double"},
      "num_winning_trades": {"type": "integer"},
      "num_losing_trades": {"type": "integer"},
      "commission": {"type": "double"},
      "created_at": {"type": "date"},
      "provenance": {
        "properties": {
          "run_timestamp_utc": {"type": "date"},
          "code": {
            "properties": {
              "git_sha": {"type": "keyword"},
              "git_sha_short": {"type": "keyword"},
              "branch": {"type": "keyword"},
              "dirty": {"type": "boolean"},
              "niffler_version": {"type": "keyword"}
            }
          },
          "data": {
            "properties": {
              "path": {"type": "keyword"},
              "sha256": {"type": "keyword"},
              "size_bytes": {"type": "long"},
              "modified_utc": {"type": "date"}
            }
          },
          "environment": {
            "properties": {
              "python_version": {"type": "keyword"},
              "platform": {"type": "keyword"},
              "packages": {
                "properties": {
                  "niffler": {"type": "keyword"},
                  "pandas": {"type": "keyword"},
                  "numpy": {"type": "keyword"},
                  "ccxt": {"type": "keyword"},
                  "yfinance": {"type": "keyword"},
                  "elasticsearch": {"type": "keyword"},
                  "python-dateutil": {"type": "keyword"}
                }
              }
            }
          }
        }
      }
    }
  }
}
